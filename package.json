{
  "name": "a2-demo",
  "version": "1.0.0",
  "description": "a2_demo · 多项目实验场：喵屋便利店 3D 小镇 + 贪吃蛇 / IPTV / 魔方 / 中药 / 陶器 / 李清照 / LLM 应用 / 抓取摘要",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "index:build": "node tools/gen-project-index.mjs",
    "prompts:build": "node tools/collect-prompts.mjs",
    "test:snake": "node snake-race/tools/selftest.mjs",
    "bench:snake": "node snake-race/tools/bench.mjs 60 3000 4",
    "bench:snake:head": "node snake-race/tools/bench.mjs 200",
    "film:shot": "node attention-film/tools/shot.mjs",
    "film:layout": "node attention-film/tools/layout.mjs",
    "film:music": "node attention-film/tools/music.mjs",
    "film:capture": "node attention-film/tools/capture.mjs 30 ../release/frames",
    "film:encode": "node attention-film/tools/encode.mjs 30 ../release/frames ../release/attention-film.mp4",
    "film:build": "npm run build && npm run film:music && npm run film:capture && npm run film:encode",
    "test:iptv": "node iptv-player/tools/selftest.mjs",
    "iptv:shot": "node iptv-player/tools/shot.mjs",
    "iptv:serve": "node iptv-player/tools/serve.mjs",
    "iptv:verify": "node iptv-player/tools/shot.mjs",
    "iptv:single": "vite build --config vite.iptv-single.config.js && node iptv-player/tools/check-single.mjs",
    "sgss:web": "cd sanguosha-ai && python main.py --web",
    "sgss:cli": "cd sanguosha-ai && python main.py --cli",
    "sgss:doctor": "cd sanguosha-ai && python main.py --doctor",
    "test:sgss": "cd sanguosha-ai && python -m pytest tests -q",
    "sgss:shot": "cd sanguosha-ai && node tools/webcheck.mjs --wait 60",
    "test:tcm": "node tcm-herb/tools/selftest.mjs",
    "tcm:verify": "node tcm-herb/tools/verify.mjs",
    "tcm:verify:online": "node tcm-herb/tools/verify.mjs --online",
    "tcm:verify:single": "node tcm-herb/tools/verify.mjs --single",
    "tcm:build": "node tcm-herb/tools/build-single.mjs",
    "tcm:images": "node tcm-herb/tools/fetch-images.mjs",
    "test:pottery": "node pottery/tools/selftest.mjs",
    "pottery:verify": "node pottery/tools/verify.mjs",
    "pottery:verify:online": "node pottery/tools/verify.mjs --online",
    "pottery:build": "node pottery/tools/build-single.mjs",
    "pottery:images": "node pottery/tools/fetch-images.mjs",
    "pottery:serve": "node pottery/tools/serve.mjs",
    "test:lqz": "node li-qingzhao/tools/selftest.mjs",
    "lqz:verify": "node li-qingzhao/tools/verify.mjs",
    "lqz:verify:online": "node li-qingzhao/tools/verify.mjs --online",
    "lqz:build": "node li-qingzhao/tools/build-single.mjs",
    "lqz:images": "node li-qingzhao/tools/fetch-images.mjs",
    "lqz:serve": "node li-qingzhao/tools/serve.mjs",
    "test:sticky": "node sticky-notes/tools/selftest.mjs",
    "sticky:verify": "node sticky-notes/tools/verify.mjs",
    "sticky:build": "node sticky-notes/tools/build-single.mjs",
    "sticky:serve": "node sticky-notes/tools/serve.mjs",
    "sticky:ai": "node sticky-notes/tools/ai-check.mjs",
    "test:rubik": "node rubiks-cube/tools/selftest.mjs",
    "rubik:verify": "node rubiks-cube/tools/verify.mjs",
    "test:endfield": "node endfield-ship/tools/selftest.mjs",
    "endfield:verify": "node endfield-ship/tools/verify.mjs",
    "endfield:lint": "node endfield-ship/tools/lint.mjs",
    "endfield:serve": "node endfield-ship/tools/serve.mjs",
    "endfield:shoot": "node endfield-ship/tools/shoot.mjs",
    "test:piano": "node piano/tools/selftest.mjs",
    "piano:verify": "node piano/tools/verify.mjs",
    "tabcolors:serve": "node tab-colors-dev/tools/serve.mjs 8787",
    "tabcolors:e2e": "node tab-colors-dev/tools/e2e.mjs",
    "test:a2share": "python -m unittest discover -s a2-share/pc/tests -t a2-share/pc",
    "a2share:selftest": "python a2-share/pc/a2_share.py --selftest",
    "a2share:e2e": "python a2-share/tools/e2e.py",
    "a2share:smoke": "python a2-share/tools/smoke.py",
    "a2share:build": "cd a2-share/phone && gradlew.bat assembleRelease",
    "a2share:test": "cd a2-share/phone && gradlew.bat testDebugUnitTest"
  },
  "keywords": [
    "three.js",
    "webgl",
    "procedural",
    "canvas",
    "arknights",
    "endfield",
    "hud",
    "iptv",
    "hls",
    "sticky-notes",
    "localstorage",
    "offline",
    "multi-project",
    "vite",
    "llm",
    "piano",
    "multitouch",
    "web-audio",
    "midi",
    "firefox",
    "webextension"
  ],
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.7.4",
    "puppeteer-core": "^25.16.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
