# 统一以 LF 存储在仓库中，检出时保持 LF（Windows 下 core.autocrlf 也不会改成 CRLF）
* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.gd    text eol=lf
*.tscn  text eol=lf
*.godot text eol=lf

*.png   binary
*.jpg   binary
*.mp4   binary
*.wav   binary
*.ttf   binary
*.exe   binary
