{
  "manifest_version": 3,
  "name": "tea_a2 划词助手",
  "version": "0.1.0",
  "description": "划词后在鼠标位置弹出横幅：翻译 / 搜索 / 总结，调用本机 tea_a2 的 /api/llm/chat。",
  "browser_specific_settings": {
    "gecko": {
      "id": "tea-select@tea-a2.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8282/*",
    "http://127.0.0.1:8282/*",
    "https://www.bing.com/*",
    "https://html.duckduckgo.com/*"
  ],
  "background": {
    "scripts": [
      "src/core.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/core.js",
        "src/banner.css.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "tea_a2 划词助手",
    "default_popup": "src/options.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "commands": {
    "open-options": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "打开 tea_a2 划词助手的设置页"
    }
  }
}
